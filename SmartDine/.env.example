# SmartDine Environment Variables
# Copy this file to .env and update with your actual values

# ============ API Configuration ============
# Backend API URL
# For Android emulator, use: http://10.0.2.2:8000
# For physical device, use your computer's IP: http://192.168.1.x:8000
# For iOS simulator, use: http://localhost:8000
API_BASE_URL=http://10.0.2.2:8000

# ============ Google Maps API ============
# Get your API key from: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============ App Configuration ============
# App environment: development, staging, production
APP_ENV=development

# Enable debug mode
DEBUG=true

# ============ Optional Services ============
# Firebase (if using)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=

# Sentry (if using for error tracking)
# SENTRY_DSN=

# ============ Notes ============
# NEVER commit the actual .env file to git!
# This is just an example template.
# Your actual .env file with real credentials is in .gitignore
