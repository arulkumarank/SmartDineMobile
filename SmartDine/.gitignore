# ====================================
# SmartDine - React Native .gitignore
# ====================================

# ============ Dependencies ============
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ============ Environment Variables ============
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
# Keep example file for reference
!.env.example

# ============ React Native ============
# Metro bundler
.metro-health-check*
.metro/

# Watchman
.watchmanconfig

# ============ Android ============
# Build outputs
android/app/build/
android/build/
android/.gradle/
android/app/.cxx/
android/captures/
android/app/release/
android/app/debug/

# APK/AAB files
*.apk
*.aab

# Signing keys (NEVER commit these!)
*.jks
*.keystore
!debug.keystore

# Local properties
android/local.properties
android/.externalNativeBuild/

# ============ iOS ============
# Build outputs
ios/build/
ios/DerivedData/
ios/Pods/

# Xcode
ios/*.xcworkspace
!ios/*.xcworkspace/contents.xcworkspacedata
ios/*.xcuserstate
ios/xcuserdata/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.hmap
*.ipa
*.dSYM.zip

# CocoaPods
Podfile.lock

# ============ IDE & Editors ============
# VSCode
.vscode/
*.code-workspace

# JetBrains (WebStorm, Android Studio)
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============ OS Files ============
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ============ Firebase & Google Services ============
# IMPORTANT: Never commit these files!
google-services.json
GoogleService-Info.plist
firebase-debug.log

# ============ API Keys & Secrets ============
# CRITICAL: Keep these secure!
secrets.json
.secrets
*.pem
*.p12
*.key
*.cert

# ============ Testing ============
coverage/
.nyc_output/
test-results/
junit.xml

# ============ TypeScript ============
*.tsbuildinfo
.tsbuildinfo

# ============ Build & Distribution ============
build/
dist/
out/
*.bundle
*.map

# ============ Logs ============
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============ Temporary Files ============
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
.cache/

# ============ Expo (if used) ============
.expo/
.expo-shared/
web-build/

# ============ Fastlane ============
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# ============ Misc ============
.eslintcache
.stylelintcache

# Yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ============ SmartDine Specific ============
# Backup files
*.backup
*.bak

# Documentation that shouldn't be tracked
RESTART_GUIDE.md
ENV_CONFIG.md

# ============ KEEP These Files ============
# Examples and documentation
!README.md
!.env.example
!LICENSE