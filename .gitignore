# ===================================
# SmartDine Project - Root .gitignore
# ===================================

# ============ Logs ============
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============ Environment Variables ============
.env
.env.local
.env.development
.env.test
.env.production
.env.staging

# Keep example env files
!.env.example

# ============ OS Files ============
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============ IDE & Editors ============
.vscode/
.idea/
*.iml
*.code-workspace

# ============ Dependencies ============
node_modules/
.venv/
venv/
__pycache__/

# ============ Build Output ============
build/
dist/
out/
*.bundle
*.apk
*.aab
*.ipa

# ============ Temporary Files ============
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*~
.cache/

# ============ Backup Files ============
*.backup
*.bak
